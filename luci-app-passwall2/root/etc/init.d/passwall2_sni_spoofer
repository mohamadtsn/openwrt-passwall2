#!/bin/sh /etc/rc.common

START=99
STOP=10

if command -v extra_command >/dev/null 2>&1; then
	extra_command "status" "Show SNI Spoofer service status"
else
	EXTRA_COMMANDS="status"
	EXTRA_HELP="	status	Show SNI Spoofer service status"
fi

boot() {
	local enabled
	enabled="$(uci -q get passwall2.global_sni_spoofer.enabled 2>/dev/null || true)"
	[ "$enabled" = "1" ] || return 0
	/usr/share/passwall2/sni_spoofer.sh start
}

start() {
	/usr/share/passwall2/sni_spoofer.sh start
}

stop() {
	/usr/share/passwall2/sni_spoofer.sh stop
}

restart() {
	stop
	start
}

status() {
	/usr/share/passwall2/sni_spoofer.sh status
}
